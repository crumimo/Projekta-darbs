  m_Script: {fileID: 11500000, guid: 7ef21ea6ca5e57243ba43e045ed9129f, type: 3}
  m_Name: WayHome
  m_EditorClassIdentifier: 
  dialogueSegments:
  - speakerName: Maya
    sentence: I see, i also wanted to go home
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Maya
    sentence: "Here, take this. \nHer name is isopoda"
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: 
    sentence: '*She hands you a curious looking creature*'
    speakerSprite: {fileID: -1896832245, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Maya
    sentence: She will help you get to the Garden, that awaits you on your way home
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Maya
    sentence: But that's all i can do
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Maya
    sentence: Anything else?
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  responses:
  - responseText: yes
    dialogueObject: {fileID: 11400000, guid: 4eae367f84a3dff4b9995e22f4bec2dd, type: 2}
  - responseText: no
    dialogueObject: {fileID: 11400000, guid: 0df61ccab4e397d479c53dbcb8b2691a, type: 2}
