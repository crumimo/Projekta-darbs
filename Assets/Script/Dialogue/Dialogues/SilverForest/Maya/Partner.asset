  dialogueSegments:
  - speakerName: Maya
    sentence: Oh...
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Maya
    sentence: We arrived here from Abyss long time ago, to collect some valuable
      resources
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Maya
    sentence: But were attacked by local wildlife
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Maya
    sentence: 'My tail is now paralized

      And she....'
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: 
    sentence: '*Did you really need to ask this?*'
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  responses: []
