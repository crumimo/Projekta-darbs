  m_Script: {fileID: 11500000, guid: 7ef21ea6ca5e57243ba43e045ed9129f, type: 3}
  m_Name: Spear
  m_EditorClassIdentifier: 
  dialogueSegments:
  - speakerName: 
    sentence: '*Golden spear my parents made*'
    speakerSprite: {fileID: -349710313, guid: ad1d8a00c9012cb49859ce3857643b2f, type: 3}
  - speakerName: 
    sentence: '*There''s a message attached to golden leaves.

      But parts of
      it are missing...*'
    speakerSprite: {fileID: -349710313, guid: ad1d8a00c9012cb49859ce3857643b2f, type: 3}
  - speakerName: 
    sentence: 'Our dear daughter '
    speakerSprite: {fileID: -349710313, guid: ad1d8a00c9012cb49859ce3857643b2f, type: 3}
  - speakerName: 
    sentence: Don't be afraid, we've sent...
    speakerSprite: {fileID: -349710313, guid: ad1d8a00c9012cb49859ce3857643b2f, type: 3}
  - speakerName: 
    sentence: We don't know ... but ... hope that u'll find a way back home
    speakerSprite: {fileID: -349710313, guid: ad1d8a00c9012cb49859ce3857643b2f, type: 3}
  - speakerName: 
    sentence: '*Looks like they also don''t know what happened*'
    speakerSprite: {fileID: -349710313, guid: ad1d8a00c9012cb49859ce3857643b2f, type: 3}
  responses: []
