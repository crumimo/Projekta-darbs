  m_Script: {fileID: 11500000, guid: 7ef21ea6ca5e57243ba43e045ed9129f, type: 3}
  m_Name: Place
  m_EditorClassIdentifier: 
  dialogueSegments:
  - speakerName: Blanka
    sentence: This place is called Silver Forest
    speakerSprite: {fileID: 1670136974, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Blanka
    sentence: It's tranquil here, as if time doesn't even exist
    speakerSprite: {fileID: 1670136974, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Blanka
    sentence: Perfect place for those who want to be forgotten
    speakerSprite: {fileID: 1670136974, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Blanka
    sentence: Anything else?
    speakerSprite: {fileID: 1670136974, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  responses:
  - responseText: Yes
    dialogueObject: {fileID: 11400000, guid: 871445a54f1e3fa4da296fcc70050d1f, type: 2}
  - responseText: No
    dialogueObject: {fileID: 11400000, guid: 511061373b343ed4f95aa4b4385af4e2, type: 2}
