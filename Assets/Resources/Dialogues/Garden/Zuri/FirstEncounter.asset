  m_Script: {fileID: 11500000, guid: 7ef21ea6ca5e57243ba43e045ed9129f, type: 3}
  m_Name: FirstEncounter
  m_EditorClassIdentifier: 
  dialogueSegments:
  - speakerName: '?'
    sentence: Hmmmmm a new mermaid?
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Zuri
    sentence: 'Don''t be scared, name''s Zuri,

      I take care of local wildlife,
      at least what''s left of it'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Zuri
    sentence: But lately something weird started to happen, my bees stopped working,
      and all they do now is sleep
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Zuri
    sentence: I've never seen something like this before...
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  responses:
  - responseText: I'll help
    dialogueObject: {fileID: 11400000, guid: 143f127d1627dde4cb5d5357dd5698af, type: 2}
