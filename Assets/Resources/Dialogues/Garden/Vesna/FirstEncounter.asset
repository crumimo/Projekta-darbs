  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ef21ea6ca5e57243ba43e045ed9129f, type: 3}
  m_Name: FirstEncounter
  m_EditorClassIdentifier: 
  dialogueSegments:
  - speakerName: 
    sentence: '*Something green is moving,

      But you can''t really see what
      it is*'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: '?'
    sentence: Oh!
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: '?'
    sentence: O-oh sorry it's not really safe here, you should probably leave
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: '?'
    sentence: Huh? Albina sent you after me? I-I guess it's time to get back
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Vesna
    sentence: 'Oh Queen, how long have i been there?

      Ssorry, my name is Vesna'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Vesna
    sentence: '*She akwardly looks at you*'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  responses:
  - responseText: Let's get back
    dialogueObject: {fileID: 11400000, guid: 84852812d323c5e41a8558ae8cd97a05, type: 2}
