  m_Name: AboutYou
  m_EditorClassIdentifier: 
  dialogueSegments:
  - speakerName: Albina
    sentence: Oh, you actually want to know that?
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: I guess a bit of talking won't hurt...
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: 'Humans would call me a witch,

      I spend most of my time here,
      trying to understand world outside.'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: Well, that's at least what i believe i'm doing
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: Anything else?
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  responses:
  - responseText: Yes
    dialogueObject: {fileID: 11400000, guid: 2ae43e7adbd23664c8ae9140c1410ad8, type: 2}
  - responseText: No
