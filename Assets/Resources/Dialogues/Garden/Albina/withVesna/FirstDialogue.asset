%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ef21ea6ca5e57243ba43e045ed9129f, type: 3}
  m_Name: FirstDialogue
  m_EditorClassIdentifier: 
  dialogueSegments:
  - speakerName: 
    sentence: '*You akwardly wait for them to notice you*'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: Oh, sorry for making you wait
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: 'Thanks for bringing her back,

      and now about how you can get
      back'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: There is a ritual that can transfer your soul into human body
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: It's a bit risky, but i suppose you're not afraid?
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: 'To perform it you have to collect three ingredients: Primordial honey,
      Human bones and a specific type of fungi'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: 'We already have some bones in storage, so you have to collect only
      two.

      Local inhabitants will help you with that'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  responses:
  - responseText: I understand
    dialogueObject: {fileID: 11400000, guid: 515bb6797f0119242a4cfd3292a9ca94, type: 2}
