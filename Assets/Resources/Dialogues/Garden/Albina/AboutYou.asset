MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ef21ea6ca5e57243ba43e045ed9129f, type: 3}
  m_Name: AboutYou
  m_EditorClassIdentifier: 
  dialogueSegments:
  - speakerName: Albina
    sentence: We know each other for less than a minute and you already ask me this
      kind of questions?
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: I guess a bit of talking won't hurt...
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: 'I guess you know what humans are?

      Maybe they would call me
      a witch'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: 'I spend most of my time here, trying to understand world outside.

      My
      "assistant" helps me with that'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Albina
    sentence: Anything else?
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  responses:
  - responseText: Yes
    dialogueObject: {fileID: 11400000, guid: 2ae43e7adbd23664c8ae9140c1410ad8, type: 2}
  - responseText: No
    dialogueObject: {fileID: 11400000, guid: d5fcbb19e4b29cc428e61af6fb65a4d9, type: 2}
