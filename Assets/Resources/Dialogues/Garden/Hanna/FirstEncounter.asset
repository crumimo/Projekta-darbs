  m_Script: {fileID: 11500000, guid: 7ef21ea6ca5e57243ba43e045ed9129f, type: 3}
  m_Name: FirstEncounter
  m_EditorClassIdentifier: 
  dialogueSegments:
  - speakerName: Hanna
    sentence: 'Ooooo Nereida!

      I''ve been waiting for you'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Hanna
    sentence: 'How do i know your name?

      Well i know a lot of things...

      Heyy,
      you also know my name^^'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Hanna
    sentence: 'Wanna know why???

      She prolly told you that,

      Or was it
      someone else?'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: Hanna
    sentence: 'Right now it doesn''t matter,

      I have something else to tell
      you'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  - speakerName: 
    sentence: '*What should i do?*'
    speakerSprite: {fileID: 0}
    switchNpcToObject: 0
    newPrefabToSpawn: {fileID: 0}
    switchBackToNpc: 0
  responses:
  - responseText: Listen to her
    dialogueObject: {fileID: 11400000, guid: 2139487a6cfc2af4aae3c0d2c604f144, type: 2}
  - responseText: Leave her
    dialogueObject: {fileID: 11400000, guid: 22da18283d7f17a45bc5ff24063e532d, type: 2}
