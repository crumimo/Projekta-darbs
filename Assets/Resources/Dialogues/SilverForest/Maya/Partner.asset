  m_Script: {fileID: 11500000, guid: 7ef21ea6ca5e57243ba43e045ed9129f, type: 3}
  m_Name: Partner
  m_EditorClassIdentifier: 
  dialogueSegments:
  - speakerName: Maya
    sentence: Oh... about us?
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Maya
    sentence: We arrived here from Abyss long time ago, to collect some valuable
      resources
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Maya
    sentence: As you can see it didn't go as planned
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Maya
    sentence: 'My tail is now paralized

      But she....'
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Maya
    sentence: And now we're chained to this place forever
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  - speakerName: Maya
    sentence: Anything else?
    speakerSprite: {fileID: -1134218312, guid: 18e6891c86361fb4da44f75cc3df11a5, type: 3}
  responses:
  - responseText: yes
    dialogueObject: {fileID: 11400000, guid: 4eae367f84a3dff4b9995e22f4bec2dd, type: 2}
  - responseText: no
    dialogueObject: {fileID: 11400000, guid: 0df61ccab4e397d479c53dbcb8b2691a, type: 2}
